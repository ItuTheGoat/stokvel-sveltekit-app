rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function membershipId(societyId, userId) {
      return societyId + '_' + userId;
    }

    function membershipRef(societyId, userId) {
      return /databases/$(database)/documents/memberships/$(membershipId(societyId, userId));
    }

    function societyRef(societyId) {
      return /databases/$(database)/documents/societies/$(societyId);
    }

    function isCreatorOfSociety(societyId) {
      return isSignedIn()
        && exists(societyRef(societyId))
        && get(societyRef(societyId)).data.creatorId == request.auth.uid;
    }

    function isMemberOfSociety(societyId) {
      return isSignedIn() && exists(membershipRef(societyId, request.auth.uid));
    }

    function isAdminOfSociety(societyId) {
      return isSignedIn()
        && (
          (
            exists(membershipRef(societyId, request.auth.uid))
            && get(membershipRef(societyId, request.auth.uid)).data.role == 'admin'
          )
          || isCreatorOfSociety(societyId)
        );
    }

    function isValidInterval(interval) {
      return interval == 'monthly';
    }

    function isValidContributionDuePreset(preset) {
      return preset in ['first_of_month', 'last_of_month', 'day_25', 'other'];
    }

    function isValidContributionDueDetails(rules) {
      return rules.contributionDueOtherDetail is string
        && rules.contributionDueOtherDetail.size() <= 120
        && (
          (
            rules.contributionDuePreset == 'other'
            && rules.contributionDueOtherDetail.size() >= 1
          )
          || (
            rules.contributionDuePreset != 'other'
            && rules.contributionDueOtherDetail.size() == 0
          )
        );
    }

    function isValidMembershipRole(role) {
      return role in ['admin', 'member'];
    }

    function isValidSocietyType(type) {
      return type in [
        'Savings',
        'Investment',
        'Burial Society',
        'Education fund',
        'Business fund',
        'other'
      ];
    }

    function isValidContributionStatus(status) {
      return status in ['pending', 'approved', 'rejected'];
    }

    function membershipDocIdMatchesBody(membershipDocId, societyId, userId) {
      return membershipDocId == membershipId(societyId, userId);
    }

    match /users/{userId} {
      allow read, create, update: if isSelf(userId);
      allow delete: if false;
    }

    match /societies/{societyId} {
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly([
          'name',
          'type',
          'description',
          'inviteCode',
          'creatorId',
          'totalPot',
          'rules'
        ])
        && request.resource.data.name is string
        && isValidSocietyType(request.resource.data.type)
        && (
          !('description' in request.resource.data)
          || (
            request.resource.data.description is string
            && request.resource.data.description.size() <= 160
          )
        )
        && request.resource.data.inviteCode is string
        && request.resource.data.creatorId == request.auth.uid
        && request.resource.data.totalPot is number
        && request.resource.data.rules is map
        && request.resource.data.rules.keys().hasOnly([
          'amount',
          'interval',
          'contributionDuePreset',
          'contributionDueOtherDetail',
          'maxMembers',
          'startDate',
          'endDate'
        ])
        && request.resource.data.rules.amount is number
        && isValidContributionDuePreset(request.resource.data.rules.contributionDuePreset)
        && isValidContributionDueDetails(request.resource.data.rules)
        && request.resource.data.rules.maxMembers is number
        && request.resource.data.rules.startDate is timestamp
        && request.resource.data.rules.endDate is timestamp
        && request.resource.data.rules.endDate >= request.resource.data.rules.startDate
        && isValidInterval(request.resource.data.rules.interval);

      allow read: if isMemberOfSociety(societyId);
      allow update: if isAdminOfSociety(societyId)
        && request.resource.data.keys().hasOnly([
          'name',
          'type',
          'description',
          'inviteCode',
          'creatorId',
          'totalPot',
          'rules'
        ])
        && request.resource.data.name is string
        && isValidSocietyType(request.resource.data.type)
        && (
          !('description' in request.resource.data)
          || (
            request.resource.data.description is string
            && request.resource.data.description.size() <= 160
          )
        )
        && request.resource.data.inviteCode is string
        && request.resource.data.creatorId is string
        && request.resource.data.totalPot is number
        && request.resource.data.rules is map
        && request.resource.data.rules.keys().hasOnly([
          'amount',
          'interval',
          'contributionDuePreset',
          'contributionDueOtherDetail',
          'maxMembers',
          'startDate',
          'endDate'
        ])
        && request.resource.data.rules.amount is number
        && isValidContributionDuePreset(request.resource.data.rules.contributionDuePreset)
        && isValidContributionDueDetails(request.resource.data.rules)
        && request.resource.data.rules.maxMembers is number
        && request.resource.data.rules.startDate is timestamp
        && request.resource.data.rules.endDate is timestamp
        && request.resource.data.rules.endDate >= request.resource.data.rules.startDate
        && isValidInterval(request.resource.data.rules.interval);
      allow delete: if isAdminOfSociety(societyId);
    }

    match /memberships/{membershipDocId} {
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly([
          'societyId',
          'userId',
          'role',
          'displayName',
          'joinedAt'
        ])
        && request.resource.data.societyId is string
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.displayName is string
        && request.resource.data.joinedAt is timestamp
        && isValidMembershipRole(request.resource.data.role)
        && membershipDocIdMatchesBody(
          membershipDocId,
          request.resource.data.societyId,
          request.resource.data.userId
        )
        && existsAfter(/databases/$(database)/documents/societies/$(request.resource.data.societyId));

      allow read: if isSignedIn()
        && (
          resource.data.userId == request.auth.uid
          || isAdminOfSociety(resource.data.societyId)
        );

      allow update, delete: if isSignedIn() && isAdminOfSociety(resource.data.societyId);
    }

    match /contributions/{contributionId} {
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly([
          'societyId',
          'userId',
          'userName',
          'amount',
          'popUrl',
          'status',
          'submittedAt'
        ])
        && request.resource.data.societyId is string
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.userName is string
        && request.resource.data.amount is number
        && request.resource.data.popUrl is string
        && request.resource.data.submittedAt is timestamp
        && request.resource.data.status == 'pending'
        && isMemberOfSociety(request.resource.data.societyId);

      allow read: if isSignedIn() && isMemberOfSociety(resource.data.societyId);

      // Admin can review and transition contribution status.
      allow update: if isSignedIn()
        && isAdminOfSociety(resource.data.societyId)
        && request.resource.data.societyId == resource.data.societyId
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.userName == resource.data.userName
        && request.resource.data.amount == resource.data.amount
        && request.resource.data.popUrl == resource.data.popUrl
        && request.resource.data.submittedAt == resource.data.submittedAt
        && resource.data.status == 'pending'
        && request.resource.data.status in ['approved', 'rejected']
        && isValidContributionStatus(request.resource.data.status);

      // Members can revise only their own pending submission details.
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && isMemberOfSociety(resource.data.societyId)
        && resource.data.status == 'pending'
        && request.resource.data.societyId == resource.data.societyId
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.userName == resource.data.userName
        && request.resource.data.status == 'pending'
        && request.resource.data.amount is number
        && request.resource.data.popUrl is string
        && request.resource.data.submittedAt == resource.data.submittedAt;

      allow delete: if isSignedIn() && isAdminOfSociety(resource.data.societyId);
    }
  }
}
