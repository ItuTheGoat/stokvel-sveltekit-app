rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function listRef(listId) {
      return /databases/$(database)/documents/lists/$(listId);
    }

    function listExists(listId) {
      return exists(listRef(listId));
    }

    function isListMember(listId) {
      return isSignedIn() && listExists(listId) && request.auth.uid in get(listRef(listId)).data.memberIds;
    }

    function listSelfJoinUpdate() {
      return isSignedIn()
        && !(request.auth.uid in resource.data.memberIds)
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
        && request.resource.data.name == resource.data.name
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    // Client stores '' when profile has no email; token email is null then — '' != null in rules.
    function redeemEmailMatchesStored(stored) {
      return (request.auth.token.email == null || request.auth.token.email == '')
        ? stored == ''
        : stored == request.auth.token.email;
    }

    match /users/{userId} {
      allow read, create, update: if isSelf(userId);
      allow delete: if false;
    }

    match /lists/{listId} {
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.auth.uid in request.resource.data.memberIds;

      // Any signed-in user may read (list ids are unguessable; enables invite redeem tx get).
      allow read: if isSignedIn();

      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;

      allow update: if isSignedIn() && resource.data.ownerId == request.auth.uid;

      allow update: if listSelfJoinUpdate();
    }

    match /listInviteCodes/{code} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['listId', 'ownerId', 'createdAt', 'consumed'])
        && request.resource.data.consumed == false
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.listId is string
        && get(listRef(request.resource.data.listId)).data.ownerId == request.auth.uid;

      allow update: if isSignedIn()
        && resource.data.consumed == false
        && request.resource.data.consumed == true
        && request.resource.data.listId == resource.data.listId
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.consumedByUid == request.auth.uid
        && redeemEmailMatchesStored(request.resource.data.consumedByEmail);

      allow delete: if isSignedIn()
        && resource.data.ownerId == request.auth.uid
        && resource.data.consumed == false;
    }

    match /listInviteRedemptions/{redemptionId} {
      allow create: if isSignedIn()
        && request.resource.data.usedByUid == request.auth.uid
        && redeemEmailMatchesStored(request.resource.data.usedByEmail)
        && request.resource.data.listId is string
        && request.resource.data.inviteCode is string
        && request.resource.data.usedAt is timestamp;

      allow read: if isSignedIn()
        && (
          resource.data.usedByUid == request.auth.uid
          || get(listRef(resource.data.listId)).data.ownerId == request.auth.uid
        );
    }

    match /places/{placeId} {
      allow create: if isSignedIn()
        && request.resource.data.listId is string
        && isListMember(request.resource.data.listId)
        && request.resource.data.imageUrls is list
        && request.resource.data.imageUrls.size() <= 5
        && (!('mainImageUrl' in request.resource.data)
          || request.resource.data.mainImageUrl is string);

      allow read: if isListMember(resource.data.listId);

      allow update: if isListMember(resource.data.listId)
        && request.resource.data.listId == resource.data.listId
        && request.resource.data.imageUrls is list
        && request.resource.data.imageUrls.size() <= 5
        && (!('mainImageUrl' in request.resource.data)
          || request.resource.data.mainImageUrl is string);

      allow delete: if isListMember(resource.data.listId);
    }
  }
}
